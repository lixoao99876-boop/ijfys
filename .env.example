# ----------------------------------------------------------
# 前端 (Next.js) 环境变量
# 复制为 .env.production 或 .env.local，并替换为你的真实域名
# ----------------------------------------------------------

# ⚠ 必填：替换 your-domain.com 为你的真实域名
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=飓风影视

# 公网 API 地址（浏览器 fetch 用，必须以 /api 结尾）
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# 服务端 SSR / sitemap / generateMetadata 调用 API 的内网地址
# 同机部署写 127.0.0.1 走内网避免出公网回环
API_URL=http://127.0.0.1:4000/api

# 错误监控（前端 Sentry 时填）
# NEXT_PUBLIC_SENTRY_DSN=
