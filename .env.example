# ----------------------------------------------------------
# 飓风影视 - web (Next.js) 环境变量
# 复制为 .env.production 或 .env.local
# ----------------------------------------------------------

# 公网访问的 API 地址（必须以 /api 结尾）
NEXT_PUBLIC_API_URL=https://ijfys.com/api

# 服务端调用 API 的内网地址（SSR / generateMetadata / sitemap 用）
# 同机部署可写 http://127.0.0.1:4000/api 走内网避免出公网回环
API_URL=http://127.0.0.1:4000/api

# 站点公网 URL（sitemap/robots/RSS/OG 用）
NEXT_PUBLIC_SITE_URL=https://ijfys.com

# 错误监控（前端 Sentry 时填）
# NEXT_PUBLIC_SENTRY_DSN=
