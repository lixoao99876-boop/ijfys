# ═══════════════════════════════════════════════════════════════
#  飓风影视 - 生产环境 server/.env 模板
#  复制为 server/.env，并按 ★ 标记替换真实值
# ═══════════════════════════════════════════════════════════════

# ─── ★ 必填 ───────────────────────────────────────────────
# PostgreSQL 14+，注意 ?schema=public 是 Prisma 私有参数
DATABASE_URL="postgresql://ijfys:STRONG_DB_PASSWORD@localhost:5432/ijfys?schema=public"

# JWT 签名密钥（32+ 位）
#   生成命令：openssl rand -hex 32
JWT_SECRET="REPLACE_WITH_openssl_rand_hex_32"

# 生产环境
NODE_ENV=production

# 监听端口（与 ecosystem.config.js / nginx upstream 对齐）
PORT=4000

# 公网域名（用于 backend 生成邮件 / 绝对 URL）
PUBLIC_SITE_URL="https://YOUR_DOMAIN.com"

# CORS 白名单（多个用逗号；上线后必须设置）
CORS_ORIGINS=https://YOUR_DOMAIN.com,https://www.YOUR_DOMAIN.com

# ─── 强烈建议 ───────────────────────────────────────────────
# Meilisearch master key (32+ 位)
#   生成命令：openssl rand -hex 32
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY="REPLACE_WITH_openssl_rand_hex_32"

# FFZY 备用域名（主域名挂掉自动降级）
PROVIDER_FFZY_BACKUP_URLS=
PROVIDER_BFZY_BACKUP_URLS=

# ─── 可选（已有合理默认）───────────────────────────────────
JWT_EXPIRES=7d
# COOKIE_SECURE=true        # NODE_ENV=production 自动 true

# 资源站基址
PROVIDER_FFZY_BASE_URL=https://cj.ffzyapi.com/api.php/provide/vod
PROVIDER_LZZY_BASE_URL=https://cj.lziapi.com/api.php/provide/vod
PROVIDER_BFZY_BASE_URL=https://bfzyapi.com/api.php/provide/vod
PROVIDER_LZZY_BACKUP_URLS=https://cj.lzcaiji.com/api.php/provide/vod

# 同步行为
SYNC_INCREMENTAL_CRON=*/10 * * * *
SYNC_PAGES_PER_RUN=10
SYNC_HOURS_BACK=1

# Meili 自动重建（每日 03:00；空字符串则不跑）
MEILI_REINDEX_CRON=0 3 * * *

# Rate Limit（默认开）
# RATE_LIMIT_ENABLED=true

# 错误监控
# SENTRY_DSN=
