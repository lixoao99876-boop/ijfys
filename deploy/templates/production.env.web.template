# ═══════════════════════════════════════════════════════════════
#  飓风影视 - 生产环境 .env.production 模板（Next.js 前端）
#  复制到项目根目录 .env.production，按 ★ 替换真实值
# ═══════════════════════════════════════════════════════════════

# ─── ★ 必填 ───────────────────────────────────────────────
# 公网根 URL（用于 sitemap / robots / RSS / OG / JSON-LD）
NEXT_PUBLIC_SITE_URL=https://YOUR_DOMAIN.com

# 站点品牌名（显示于浏览器标题、底部版权、RSS channel）
NEXT_PUBLIC_SITE_NAME=飓风影视

# 浏览器 fetch API 用的公网地址（必须以 /api 结尾）
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN.com/api

# ─── 推荐 ───────────────────────────────────────────────
# SSR / sitemap / generateMetadata 内网调用（同机部署用 127.0.0.1）
API_URL=http://127.0.0.1:4000/api

# ─── 可选 ───────────────────────────────────────────────
# 前端错误监控
# NEXT_PUBLIC_SENTRY_DSN=
