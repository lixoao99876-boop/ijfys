# ----------------------------------------------------------
# 飓风影视 - server 环境变量
# 复制为 .env 并按需修改
# ----------------------------------------------------------

# ─── 必填 ───────────────────────────────────────────────
# PostgreSQL 14+
DATABASE_URL="postgresql://ijfys:ijfys@localhost:5432/ijfys?schema=public"

# JWT 签名密钥 —— 生产必须替换为 32+ 位随机字符串，否则启动失败
#   生成：openssl rand -hex 32
JWT_SECRET="change-me-in-production-must-be-32+-chars"

# Node 运行环境
NODE_ENV=production

# 监听端口
PORT=4000

# 站点域名（用于 sitemap/RSS/邮件等绝对 URL）
PUBLIC_SITE_URL="https://ijfys.com"

# ─── 可选 ───────────────────────────────────────────────
# JWT token 过期（默认 7d）
JWT_EXPIRES=7d

# Cookie 配置（生产 secure=true 强制 HTTPS）
# COOKIE_SECURE=true        # 默认 NODE_ENV=production 时为 true

# Meilisearch（缺失时搜索自动降级到 ILIKE + trgm）
MEILI_HOST=http://127.0.0.1:7700
# MEILI_API_KEY=

# 资源站基址
PROVIDER_FFZY_BASE_URL=https://cj.ffzyapi.com/api.php/provide/vod
PROVIDER_LZZY_BASE_URL=https://cj.lziapi.com/api.php/provide/vod
PROVIDER_BFZY_BASE_URL=https://bfzyapi.com/api.php/provide/vod

# 备用域名（主挂自动切换；逗号分隔）
PROVIDER_LZZY_BACKUP_URLS=https://cj.lzcaiji.com/api.php/provide/vod
# PROVIDER_FFZY_BACKUP_URLS=
# PROVIDER_BFZY_BACKUP_URLS=

# 同步行为
SYNC_INCREMENTAL_CRON="*/10 * * * *"
SYNC_PAGES_PER_RUN=10
SYNC_HOURS_BACK=1

# Meili 自动重建 cron（默认每日 03:00；空字符串则不自动重建）
MEILI_REINDEX_CRON="0 3 * * *"

# CORS 允许的 origin（多个用逗号；空 = production 拒绝跨域）
CORS_ORIGINS=https://ijfys.com,https://www.ijfys.com

# Rate Limit 总开关（默认开；置 false 关闭）
# RATE_LIMIT_ENABLED=true

# 错误监控（接 Sentry 时填）
# SENTRY_DSN=
